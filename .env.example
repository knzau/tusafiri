# Web app. The API is a separate process on PORT.
WEB_ORIGIN=http://localhost:3000

# API
PORT=3001
DATABASE_URL=postgres://tusafiri:tusafiri@localhost:5432/tusafiri

# Host port for Postgres when 5432 is already taken.
# If you set this, use the same port in DATABASE_URL.
# DB_PORT=5432

# Google OAuth web client.
# Authorized redirect URI: {WEB_ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# At least 32 random characters. Example: openssl rand -base64 32
BETTER_AUTH_SECRET=
