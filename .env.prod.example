# Copy to .env.prod on the server. Never commit .env.prod.
# Create an A record for APP_DOMAIN that points at the VPS before issuing a certificate.

APP_DOMAIN=example.com
CERTBOT_EMAIL=you@example.com

# URL-safe password. Compose embeds it in DATABASE_URL.
POSTGRES_USER=tusafiri
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=tusafiri
